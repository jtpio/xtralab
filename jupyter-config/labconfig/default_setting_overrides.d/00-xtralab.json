{
  "@jupyterlab/application-extension:shell": {
    "dockPanelPadding": false,
    "activityBarPosition": "top",
    "layout": {
      "single": {
        "xtralab-running-terminals": { "options": { "rank": 1 } },
        "xtralab:file-browser": { "options": { "rank": 2 } },
        "jp-git-sessions": { "options": { "rank": 3 } },
        "filebrowser": { "options": { "rank": 4 } },
        "jp-running-sessions": { "options": { "rank": 5 } },
        "jp-search-replace": { "options": { "rank": 6 } }
      },
      "multiple": {
        "xtralab-running-terminals": { "options": { "rank": 1 } },
        "xtralab:file-browser": { "options": { "rank": 2 } },
        "jp-git-sessions": { "options": { "rank": 3 } },
        "filebrowser": { "options": { "rank": 4 } },
        "jp-running-sessions": { "options": { "rank": 5 } },
        "jp-search-replace": { "options": { "rank": 6 } }
      }
    }
  },
  "@jupyterlab/shortcuts-extension:shortcuts": {
    "shortcuts": [
      {
        "command": "filebrowser:toggle-main",
        "keys": ["Accel Shift F"],
        "selector": "body",
        "disabled": true
      }
    ]
  },
  "@jupyterlab/git:plugin": {
    "fileClickAction": "diff-on-single"
  },
  "@jupyterlab/terminal-extension:plugin": {
    "fontFamily": "MesloLGS NF, ui-monospace, monospace"
  },
  "jupyterlab-quickopen:plugin": {
    "respectGitignore": true
  },
  "@jupyterlab/completer-extension:manager": {
    "autoCompletion": true,
    "showDocumentationPanel": true
  },
  "@jupyter-lsp/jupyterlab-lsp:completion": {
    "continuousHinting": true
  },
  "@jupyterlab/codemirror-extension:plugin": {
    "defaultConfig": {
      "autoClosingBrackets": true,
      "codeFolding": true,
      "highlightActiveLine": true,
      "highlightTrailingWhitespace": true,
      "scrollPastEnd": true
    }
  },
  "@jupyterlab/docmanager-extension:plugin": {
    "defaultViewers": {
      "json": "Editor"
    }
  },
  "@jupyterlab/notebook-extension:tracker": {
    "recordTiming": true
  }
}
