{
  "name": "@xtralab/desktop",
  "productName": "Xtralab",
  "version": "0.2.0",
  "description": "Electron desktop shell for Xtralab.",
  "private": true,
  "license": "BSD-3-Clause",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:python": "uv build --wheel --out-dir python/wheels ..",
    "dev": "npm run build && npm run build:python && electron .",
    "start": "npm run build && npm run build:python && electron-forge start",
    "package": "npm run build && npm run build:python && electron-forge package",
    "make": "npm run build && npm run build:python && electron-forge make",
    "publish": "npm run build && npm run build:python && electron-forge publish",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.forge.json"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.0",
    "@electron-forge/maker-dmg": "^7.11.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.0",
    "@electron-forge/plugin-fuses": "^7.11.0",
    "@electron-forge/shared-types": "^7.11.0",
    "@electron/fuses": "^1.8.0",
    "@reforged/maker-appimage": "^5.1.0",
    "@types/node": "25.6.0",
    "electron": "42.0.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "encoding": "^0.1.13"
  },
  "overrides": {
    "tar": "^7.5.14",
    "@tootallnate/once": "^3.0.1"
  }
}
